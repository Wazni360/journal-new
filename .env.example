# Auth
# Generate with: node scripts/hash-password.js "your password"
APP_PASSWORD_HASH_B64=
# Random 32+ byte secret for signing session JWTs. Rotating it logs out every device.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Cloudflare R2 (S3 API). Token scoped to this bucket only, Object Read & Write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Postgres (Supabase). Use the session-mode pooler connection string (port 5432).
# Supabase dashboard → Connect → Session pooler.
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Vercel Cron auth for /api/cron/keepalive.
# Generate with: openssl rand -hex 32
CRON_SECRET=
